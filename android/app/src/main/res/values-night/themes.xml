<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="SteerTTS" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:colorPrimary">#6FD8B8</item>
        <item name="android:colorAccent">#6FD8B8</item>
        <item name="android:colorControlActivated">#6FD8B8</item>
        <item name="android:windowBackground">#0F1513</item>
        <item name="android:statusBarColor">#0F1513</item>
        <item name="android:navigationBarColor">#0F1513</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:alertDialogTheme">@style/SteerTTS.Dialog</item>
        <item name="android:timePickerDialogTheme">@style/SteerTTS.Dialog</item>
    </style>

    <!-- dialogs: rounded, Whissle green, sentence-case buttons -->
    <style name="SteerTTS.Dialog" parent="@android:style/Theme.Material.Dialog.Alert">
        <item name="android:colorAccent">#6FD8B8</item>
        <item name="android:colorControlActivated">#6FD8B8</item>
        <item name="android:windowBackground">@drawable/dialog_bg</item>
        <item name="android:buttonBarButtonStyle">@style/SteerTTS.DialogButton</item>
    </style>
    <style name="SteerTTS.DialogButton" parent="@android:style/Widget.Material.Button.Borderless.Colored">
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">15sp</item>
    </style>
</resources>

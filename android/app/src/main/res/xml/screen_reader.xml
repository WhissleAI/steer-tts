<?xml version="1.0" encoding="utf-8"?>
<!-- "Read this screen": window content only when the user starts it; no events are watched; the accessibility button
     starts and stops reading -->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:description="@string/screen_reader_description"
    android:summary="@string/screen_reader_summary"
    android:accessibilityEventTypes="typeWindowStateChanged"
    android:accessibilityFeedbackType="feedbackSpoken"
    android:accessibilityFlags="flagRequestAccessibilityButton"
    android:canRetrieveWindowContent="true"
    android:canPerformGestures="true"
    android:notificationTimeout="300" />

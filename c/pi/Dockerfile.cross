# Cross-compiler for 64-bit Raspberry Pi OS from any x86-64 (or arm64) machine with Docker: Debian bookworm, the base
# of Raspberry Pi OS bookworm, so the binaries need nothing newer than the Pi's glibc. Used by pi/cross-build.sh.
FROM debian:bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends crossbuild-essential-arm64 cmake make \
    && rm -rf /var/lib/apt/lists/*
